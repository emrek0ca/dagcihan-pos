{
  "$schema": "./barcode-rules.schema.md",
  "weightedFormatConfirmed": false,
  "_not": [
    "CAS CL3000'in gercek barkod formati HENUZ DOGRULANMADI.",
    "Asagidaki kurallar ADAYDIR ve hepsi enabled=false'tur.",
    "Yanlis kuralla yanlis fiyat hesaplamaktansa satir eklenmemesi tercih edilmistir.",
    "",
    "Magazada yapilacak: teraziden 1 etiket bas, okut (veya 'pos barcode try <kod>' calistir),",
    "sonra 'pos barcode analyze' ile hangi adayin tuttugunu gor, ilgili kurali enabled=true yap",
    "ve weightedFormatConfirmed=true olarak isaretle."
  ],
  "minPlainLength": 4,
  "maxPlainLength": 48,
  "limits": {
    "maxWeightMilli": 50000,
    "maxPriceKurus": 500000,
    "minPriceKurus": 1
  },
  "discoveryPrefixes": [
    "2"
  ],
  "rules": [
    {
      "id": "cas-w5-plu5-weight",
      "description": "EAN13, prefix 20-29, 5 hane PLU, 5 hane AGIRLIK (3 ondalik)",
      "enabled": false,
      "priority": 10,
      "length": 13,
      "match": {
        "type": "prefixRange",
        "from": "20",
        "to": "29"
      },
      "checkDigit": {
        "algorithm": "EAN13"
      },
      "fields": {
        "itemCode": {
          "offset": 2,
          "length": 5,
          "lookup": "PLU",
          "stripLeadingZeros": true
        },
        "value": {
          "offset": 7,
          "length": 5,
          "scale": 3,
          "kind": "WEIGHT_KG"
        }
      }
    },
    {
      "id": "cas-w5-plu5-price",
