# =====================================================================
#  Dagci POS Platform - ortam degiskenleri ORNEGI
#
#  GERCEK dosya sunucuda /etc/dagci-pos-platform/.env icindedir,
#  root:dagcipos sahipli ve 0640 izinlidir. GIT'E GIRMEZ.
#  Bu dosyada GERCEK PAROLA BULUNMAZ.
# =====================================================================

NODE_ENV=production

# Yalnizca localhost'ta dinler; disariya nginx uzerinden acilir.
HOST=127.0.0.1
PORT=8110

# PostgreSQL. Bu sunucuda mevcut PostgreSQL 16 ornegi 5433 portunda ve
# YALNIZCA localhost'ta dinliyor; veritabani internete acik degildir.
#   Parola kurulumda uretilir:  openssl rand -base64 33 | tr -d '/+=' | head -c 40
DATABASE_URL=postgresql://dagci_pos:BURAYA_URETILEN_PAROLA@127.0.0.1:5433/dagci_pos
DB_POOL_MAX=10

# debug | info | warn | error   (uretimde info)
LOG_LEVEL=info

# nginx arkasinda calisildigi icin gercek istemci IP'si X-Forwarded-For'dan alinir
TRUST_PROXY=true

# Guvenlik sinirlari
MAX_BODY_BYTES=2097152
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SYNC_BATCH_MAX=200

# Kullanici oturumu suresi (saat)
SESSION_TTL_HOURS=12

# Cihaz token suresi (gun). Bos birakilirsa token suresizdir ve yalnizca
# yonetim ekranindan iptal ile gecersiz kilinir.
# DEVICE_TOKEN_TTL_DAYS=365
